body {
    width: 100%;
    height: 100%;
    margin: 0;
}

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 20px;
    margin-left: -6px;
    margin-top: -6px;
}

.vCrosshair {
    position: absolute;
    left: 5px;
    top: 1px;
    height: 10px;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}

.hCrosshair {
    position: absolute;
    left: 1px;
    top: 5px;
    width: 10px;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.75);
}